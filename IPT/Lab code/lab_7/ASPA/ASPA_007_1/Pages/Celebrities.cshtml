@page
@model ASPA_007_1.Pages.CelebritiesModel
@using DAL_Celebrity;
@using DAL_Celebrity_MSSQL;
@{
    Layout = null;
}
<h1>Celebrity</h1>
<div class="container">

    @foreach (Celebrity celebrity in Model.Celebrities)
    {
       
        <img src="~/Photos/@celebrity.ReqPhotoPath" alt="@celebrity.FullName"    onload="onPhotoLoad(this,200,0)">

    }
    <p id="events">

    </p>
</div>


<style>
    img {
        cursor:pointer;
    }

    .container {
        display: flex;
        flex-flow: row wrap;
    }

    .container img 
    {
      flex: 1 1 10%;
      margin: 0;
    }
    .container #events{
        flex:1 1 100%;
    }
</style>
<script>

     function onPhotoLoad(e, h, w) {
        let ratio = e.naturalWidth / e.naturalHeight;

        if (h != 0 && w == 0) {
            e.width = Math.round(ratio * h);
        }
        if (h == 0 && w != 0) {
            e.height = Math.round(w / ratio);
        }
    }
</script>