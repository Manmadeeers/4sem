<!-- Themes/Generic.xaml -->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=mscorlib"
  xmlns:ctrl="clr-namespace:SoftwareShop.Views">
    <sys:String x:Key="Conn">Server=DESKTOP-I\SARVAR;Database=SoftDB; TrustServerCertificate=Yes; Integrated Security=True;</sys:String>
    <!-- 1st control template -->
    <Style TargetType="{x:Type ctrl:MyFirstControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:MyFirstControl}">
					<Border Width="50" x:Name="PART_Border" Background="Black"  Padding="5" Margin="0,0,10,0">
						<TextBlock Text="{TemplateBinding IntValue}"
                                   Foreground="White"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- 2nd control template -->
	<Style TargetType="{x:Type ctrl:MySecondControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:MySecondControl}">
					<Border x:Name="PART_Border" Background="Green" Padding="5" Width="50">
						<TextBlock Text="{TemplateBinding Text}"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
